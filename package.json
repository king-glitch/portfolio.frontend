{
  "name": "react-router-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "typecheck:scripts": "tsc -p scripts/lint-style/tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint:tw": "bun scripts/lint-tailwind/index.ts",
    "lint:style": "bun scripts/lint-style/index.ts",
    "pretty": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.ts\" \"docs/**/*.md\"",
    "build:tokens": "bun scripts/build-token/index.ts",
    "build:portfolio": "bun scripts/build-portfolio/index.ts",
    "build:locales": "bun scripts/build-locales/index.ts",
    "test": "bun test",
    "check": "bun run typecheck && bun run typecheck:scripts && bun run lint:style && bun run lint:tw && bun run test && bun run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-query": "^5.104.0",
    "@types/bun": "^1.4.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "i18next": "^26.4.2",
    "isbot": "^5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "react-router": "8.4.0",
    "shadcn": "^4.21.1",
    "sugar-high": "^2.5.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/parser": "^7",
    "@babel/types": "^7",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.2",
    "vite": "^8"
  }
}
