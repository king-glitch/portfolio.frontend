{
  "name": "react-router-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "typecheck:scripts": "tsc -p scripts/lint-style/tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint:tw": "bun scripts/lint-tailwind/index.ts",
    "lint:style": "bun scripts/lint-style/index.ts",
    "pretty": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.ts\" \"docs/**/*.md\"",
    "build:tokens": "bun scripts/build-token/index.ts",
    "build:portfolio": "bun scripts/build-portfolio/index.ts",
    "test": "bun test",
    "check": "bun run typecheck && bun run typecheck:scripts && bun run lint:style && bun run lint:tw && bun run test && bun run build",
    "deploy": "react-router build && firebase deploy --only hosting",
    "deploy:only": "firebase deploy --only hosting"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^7.0.8",
    "@react-router/node": "8.5.2",
    "@react-router/serve": "8.5.2",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-query": "^5.108.3",
    "@types/bun": "^1.4.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "i18next": "^27.2.5",
    "isbot": "^5.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "react-router": "8.5.2",
    "shadcn": "^4.23.0",
    "sugar-high": "^2.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.3",
    "@babel/types": "^8.1.3",
    "@react-router/dev": "8.5.2",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/oxide": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
